# ==============================================================================
# HIREVIBE ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Database Connection
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Vercel Production (Vercel Postgres, Supabase, Neon, Railway):
# Automatically provided by Vercel Postgres integration, or set manually:
# DATABASE_URL="postgresql://user:password@host:5432/hirevibe?sslmode=require"

# 2. Authentication & JWT
# Minimum 32-character random secret key
JWT_SECRET="hirevibe-enterprise-secret-key-32-chars-minimum"

# 3. Public Application URL
NEXT_PUBLIC_APP_URL="https://hirevibe.vercel.app"

# 4. Transactional Email Service (Optional for SendGrid / SMTP)
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="SG.your-api-key-here"
# EMAIL_FROM="advisory@hirevibe.in"
